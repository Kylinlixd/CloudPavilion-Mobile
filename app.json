{
  "expo": {
    "name": "云阁",
    "slug": "cloudpavilion",
    "version": "1.0.0",
    "owner": "kylinlees-team",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cloudpavilion",
    "icon": "./assets/cloudpavilion-logo.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/cloudpavilion-logo.png",
      "bundleIdentifier": "com.kylinlixd.cloudpavilion",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.kylinlixd.cloudpavilion",
      "versionCode": 1,
      "icon": "./assets/cloudpavilion-logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cloudpavilion-logo.png",
        "backgroundColor": "#12332d"
      }
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", {"photosPermission": "允许云阁选择书摘图片。", "cameraPermission": "允许云阁拍摄书籍封面或版权页，识别书目信息。", "microphonePermission": false}],
      [
        "expo-camera",
        {
          "cameraPermission": "允许云阁扫描 ISBN 或拍摄书籍识别信息。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/cloudpavilion-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#72c8ef"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ae94bff8-e84f-445c-a26d-01ccaf54edeb"
      }
    }
  }
}
